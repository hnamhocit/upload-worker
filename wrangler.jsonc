{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upload",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "IAM_ISSUER": "https://iam.hnamhocit.workers.dev",
    "R2_ACCOUNT_ID": "750b0664bc41c8b75d5ebfda30a0584d",
    "R2_BUCKET_NAME": "vntez-bucket"
  },
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "vntez-bucket",
      "preview_bucket_name": "vntez-bucket-preview"
    }
  ],
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "UPLOAD_APP_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_CREATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_PART_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_MANAGE_LIMIT",
      "namespace_id": "1004",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
