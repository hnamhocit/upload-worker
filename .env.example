# JWT Secret for token verification (shared with IAM Worker)
JWT_SECRET=your-jwt-secret-key-256-bits-or-more

# R2 Bucket Configuration
R2_BUCKET_NAME=vntez-bucket

# (Optional) Custom Public CDN Domain (e.g. https://cdn.yourdomain.com)
# If not set, defaults to https://{bucket_name}.r2.dev
PUBLIC_R2_DOMAIN=https://r2.yourdomain.com

# Cloudflare Account ID (legacy, may not be needed with R2 bindings)
R2_ACCOUNT_ID=750b0664bc41c8b75d5ebfda30a0584d

# R2 API Token Credentials (legacy S3-compatible, optional if using bindings)
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
